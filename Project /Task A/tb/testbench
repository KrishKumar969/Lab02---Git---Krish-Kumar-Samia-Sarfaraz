`timescale 1ns / 1ps

module TopProcessor_tb;

    reg        clk;
    reg        reset;
    reg        btn_reset;
    reg [15:0] switch_in;

    wire [15:0] led_out;
    wire [6:0]  seg;
    wire [3:0]  an;
    wire        dp;

    TopProcessor dut (
        .clk       (clk),
        .reset     (reset),
        .btn_reset (btn_reset),
        .switch_in (switch_in),
        .led_out   (led_out),
        .seg       (seg),
        .an        (an),
        .dp        (dp)
    );

    always #5 clk = ~clk;

    initial begin
        clk = 0;
        reset = 0;
        btn_reset = 0;
        switch_in = 16'b0000_0000_0000_0111;
    
        reset = 1;
        #100;
        reset = 0;
    
        #2700000000;   // enough for 7 -> 0
    
        $finish;
    end

    // Print whenever LED output changes
    always @(led_out) begin
        $display("time=%0t led_out=%d hex=%h", $time, led_out, led_out);
    end

endmodule
