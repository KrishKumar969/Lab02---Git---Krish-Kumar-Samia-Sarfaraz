.text
.globl _start

_start:
    addi x5, x0, 512
    addi x6, x0, 768
    addi x7, x0, 772

main_loop:
    lw   x20, 0(x7)
    beq  x20, x0, no_reset
    sw   x0, 0(x5)
    j    main_loop

no_reset:
    lw   x9, 0(x6)
    beq  x9, x0, main_loop

    addi x10, x9, 0
    addi x11, x0, 0
    addi x12, x0, 1

sum_loop:
    add  x11, x11, x12
    sw   x11, 0(x5)

    beq  x12, x10, done

    addi x12, x12, 1
    j    sum_loop

done:
    sw   x11, 0(x5)

wait_switch_zero:
    lw   x9, 0(x6)
    beq  x9, x0, main_loop
    j    wait_switch_zero
